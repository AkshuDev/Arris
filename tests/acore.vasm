section .data
section .bss
section .rodata
section .text
global __arris__compilerinjected__main
__arris__compilerinjected__main:
	pop qG1
	mov qG2, qSP
	push qSF
	mov qSF, qSP
	call main
	mov qSP, qSF
	pop qSF
	mov qG1, qG0
	mov qG0, 0
	syscall
runlang_python:
	push qSF
	mov qSF, qSP
	sub qSF, 8
	mov [qSF + 0], qG1
;;@Runlang: python-simple
;;(0, 8)
;;@Runlang-End
	mov qG0, 0
	mov qSP, qSF
	pop qSF
	ret
__arris_syscall:
	push qSF
	mov qSF, qSP
	sub qSF, 48
	mov [qSF + 0], qG1
	mov [qSF + 8], qG2
	mov [qSF + 16], qG3
	mov [qSF + 24], qG4
	mov [qSF + 32], qG5
	mov [qSF + 40], qG6
; VASM Runlang
	mov qG0, 0
	mov qSP, qSF
	pop qSF
	ret
__arris_exit:
	push qSF
	mov qSF, qSP
	sub qSF, 8
	mov [qSF + 0], qG1
	mov qG0, 0
	mov qG1, qG0
	mov qG0, [qSF + 0]
	mov qG2, qG0
	mov qG0, 0
	mov qG3, qG0
	mov qG0, 0
	mov qG4, qG0
	mov qG0, 0
	mov qG5, qG0
	mov qG0, 0
	mov qG6, qG0
	call __arris_syscall
	mov qG0, 0
	mov qSP, qSF
	pop qSF
	ret