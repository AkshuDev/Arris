section .data
section .bss
section .rodata
str0: db 104, 105, 0
section .text
global __main
__main:
	pop qG1
	mov qG2, qSP
	push qSF
	mov qSF, qSP
	call main
	mov qSP, qSF
	pop qSF
	mov qG1, qG0
	mov qG0, 0
	syscall
	mov qG0, 0
	mov qSP, qSF
	pop qSF
	ret
runlang_python:
	push qSF
	mov qSF, qSP
	sub qSF, 64
	mov [qSF + 64], qG1
;;@Runlang: python-simple
;;
;;@Runlang-End
	mov qG0, 0
	mov qSP, qSF
	pop qSF
	ret
print_stdout:
	push qSF
	mov qSF, qSP
	sub qSF, 64
	mov [qSF + 64], qG1
	mov qG1, [qSP + 1]

	push 'p'
	push 'r'
	push 'i'
	push 'n'
	push 't'
	push '('
	push '''
	push '$'
	push '''
	push ')'
	push 0

	call runlang_python
	mov qG0, 0
	mov qSP, qSF
	pop qSF
	ret
main:
	push qSF
	mov qSF, qSP
	lea qG0, [str0]
	mov qG1, str0
	call print_stdout
	mov qG0, 0
	mov qSP, qSF
	pop qSF
	ret