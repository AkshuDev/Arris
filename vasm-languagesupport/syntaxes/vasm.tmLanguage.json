{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "VASM",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#sections"
		},
		{
			"include": "#labels"
		},
		{
			"include": "#datatypes"
		},
		{
			"include": "#numerics"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#registers"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.instruction.vasm",
					"match": "\\b(mov|ld|st|lea|push|pop|call|ret|nop|halt|syscall|int|add|sub|mul|imul|div|idiv|mod|inc|dec|neg|cmp|test|and|or|xor|not|shl|shr|sar|rol|ror|jmp|je|jne|jg|jl|jge|jle|jo|jno|js|jns|jc|jnc|jz|jnz|loop|loopz|loopnz)\\b"
				},
				{
					"name": "keyword.directive.vasm",
					"match": "\\b(section|global|extern|align|eq|define|macro|endm|org|bits|end"
				}
			]
		},
		"datatypes": {
			"patterns": [{
				"name": "storage.type.vasm",
				"match": "\\b(db|dw|dd|dq|resb|resw|resd|resq)\\b"
			}]
		},
		"sections": {
			"patterns": [{
				"name": "entity.name.section.vasm",
				"match": "\\.(text|bss|data|rodata)\\b"
			}]
		},
		"labels": {
			"patterns": [{
				"name": "entity.name.label.vasm",
				"match": "^[a-zA-Z_][a-zA-Z0-9_]*:"
			}]
		},
		"strings": {
			"name": "string.quoted.double.vasm",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.vasm",
					"match": "\\\\."
				}
			]
		},
		"numerics": {
			"patterns": [
				{
					"name": "constant.numeric.dec.vasm",
					"match": "\\b[0-9]+\\b"
				},
				{
					"name": "constant.numeric.bin.vasm",
					"match": "\\b0b[01]+\\b"
				},
				{
					"name": "constant.numeric.hex.vasm",
					"match": "\\b0x[0-9A-Fa-f]+\\b"
				}
			]
		},
		"comments": {
			"patterns": [{
				"name": "comment.line.semicolon.vasm",
				"match": ";.*$"
			}]
		},
		"registers": {
			"patterns": [{
				"name": "variable.language.registers.vasm",
				"match": "\\b([bwdq])(g(1-[0-3]|[0-9])sf|sp)\\b"
			}]
		}
	},
	"scopeName": "source.vasm"
}